# Copy to .env.local and fill in. Never commit real values.

# --- Database: Supabase ---------------------------------------------------
SUPABASE_URL=

# The secret "service_role" key (newer dashboards: "secret" key, sb_secret_...).
# Server-only — never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Folder for the local JSON store (only used when Supabase isn't configured).
DATA_DIR=./data

# --- Email (SMTP) --------------------------------------------------------.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Shown as the sender. Must be an address/domain your provider lets you send from.
EMAIL_FROM="Juniper & Pine Woodworks <invoices@example.com>"

EMAIL_ALLOWED_RECIPIENTS=you@example.com
